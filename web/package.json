{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "build": "npm run format:check && npm run lint && tsc -b && vite build",
    "build:watch": "vite build --mode=development --watch",
    "lint": "eslint .",
    "preview": "vite preview --host=0.0.0.0",
    "format": "prettier src/**/*.{js,ts,jsx,tsx,css,sass,scss} --write",
    "format:check": "prettier src/**/*.{js,ts,jsx,tsx,css,sass,scss} --check"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.120.13",
    "bulma": "^1.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tanstack/react-router-devtools": "^1.120.13",
    "@tanstack/router-plugin": "^1.120.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
