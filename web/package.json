{
  "name": "web",
  "private": true,
  "version": "v0.1.0",
  "type": "module",
  "scripts": {
    "build:watch": "NODE_ENV=development vite build --mode=development --watch",
    "build": "npm run format:check && npm run lint && tsc -b && vite build",
    "bulma": "sass --load-path=node_modules app.scss src/styles/app.css",
    "dev": "vite --host=0.0.0.0",
    "format:check": "prettier app.scss index.html src/**/*.{js,ts,jsx,tsx,css,sass,scss} --check",
    "format": "prettier app.scss index.html src/**/*.{js,ts,jsx,tsx,css,sass,scss} --write",
    "lint": "eslint .",
    "preview": "vite preview --host=0.0.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-router": "^1.120.13",
    "axios": "^1.9.0",
    "bulma": "^1.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "sass": "^1.89.2",
    "use-prefers-color-scheme": "^1.1.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tanstack/react-query-devtools": "^5.80.6",
    "@tanstack/react-router-devtools": "^1.120.13",
    "@tanstack/router-plugin": "^1.120.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
