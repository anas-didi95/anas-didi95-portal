type Query {
  users(pageNo: Int!, totalRecordsPerPage: Int): UserSearch
  user(id: ID!): User!
}

type UserSearch {
  resultList: [User]!
  pagination: Pagination!
}

type User {
  id: ID!
  isDeleted: Boolean!
  version: Int!
  createBy: String!
  createDate: String!
  updateBy: String!
  updateDate: String!
  username: String!
  name: String!
  lastSigninDate: String
}

type Pagination {
  pageNo: Int!
  totalRecords: Int!
  totalRecordsPerPage: Int
}
