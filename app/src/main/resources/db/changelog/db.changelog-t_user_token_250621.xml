<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd
                      http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet id="db.changelog-t_user_token_250621" author="anas" labels="user">
    <createTable
      tableName="T_USER_TOKEN">
      <!-- Metadata START -->
      <column name="ID" type="UUID">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="IS_DEL" type="BOOLEAN">
        <constraints nullable="false" />
      </column>
      <column name="VER" type="INTEGER">
        <constraints nullable="false" />
      </column>
      <column name="CREATE_BY" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="CREATE_DT" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false" />
      </column>
      <column name="UPDATE_BY" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="UPDATE_DT" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false" />
      </column>
      <!-- Metadata END   -->
      <column name="USER_ID" type="UUID">
        <constraints nullable="false" />
      </column>
      <column name="EFF_FROM_DT" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="T_USER_TOKEN" baseColumnNames="USER_ID"
      constraintName="FK_USER_TOKEN_USER_ID"
      referencedTableName="T_USER" referencedColumnNames="ID" />
    <addUniqueConstraint tableName="T_USER_TOKEN" columnNames="USER_ID" />

    <createIndex indexName="IX_USER_TOKEN_USER_ID" tableName="T_USER_TOKEN">
      <column name="USER_ID" />
    </createIndex>
  </changeSet>
</databaseChangeLog>
